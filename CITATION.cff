# Citation metadata (Citation File Format 1.2.0). GitHub shows it under
# "Cite this repository"; Zenodo reads it when a release is archived.
# Update `version` and `date-released` at every release. `doi` is the Zenodo
# concept DOI (all versions; it resolves to the latest one) and does not change.
cff-version: 1.2.0
message: "If you use ClimCanvas, please cite it with the version you used."
type: software
title: "ClimCanvas"
abstract: "A browser-based GUI for plotting atmospheric and ocean data in netCDF, with export of standalone reproduction scripts."
authors:
  - family-names: "Mori"
    given-names: "Masato"
version: "1.02"
date-released: "2026-10-03"
doi: "10.5281/zenodo.22997360"
license: "AGPL-3.0-only"
repository-code: "https://github.com/ClimCanvas/ClimCanvas"
url: "https://www.atmos.rcast.u-tokyo.ac.jp/climcanvas/"
keywords:
  - netCDF
  - visualization
  - atmospheric science
  - oceanography
  - climate
  - matplotlib
  - cartopy
